# Database
# Local development uses Postgres — see docs/verification/next-api.md for the
# one-line docker command that spins up a matching instance. SQLite support
# was removed (issue #80); the Notification model's Json columns aren't
# supported by the SQLite connector.
DATABASE_URL="postgresql://family_app:dev-only-password@localhost:5432/family_recipe_dev"

# For Cloud SQL dev (via Cloud SQL Auth Proxy):
# DATABASE_URL="postgresql://family_app:DB_PASSWORD@127.0.0.1:5432/family_recipe_dev?sslmode=disable"
# PRISMA_SCHEMA="prisma/schema.postgres.prisma"

# For Cloud Run + Cloud SQL connector (Unix socket):
# DATABASE_URL="postgresql://family_app:DB_PASSWORD@localhost:5432/family_recipe_prod?host=/cloudsql/PROJECT:REGION:INSTANCE"
# PRISMA_SCHEMA="prisma/schema.postgres.prisma"

# JWT Secret
# IMPORTANT: Generate a strong, random secret for production
# Example: openssl rand -base64 32
JWT_SECRET="jwt-secret-placeholder"

# Family bootstrap
# Optionally pre-set the initial family name and master key for seeding.
# If FAMILY_MASTER_KEY is omitted, seed will generate a secure random key and print it to the console.
FAMILY_NAME="Family Recipe"
# FAMILY_MASTER_KEY="change-me"  # leave commented to auto-generate

# Uploads
# When UPLOADS_BUCKET is set, photos are stored in GCS with signed URLs.
# When unset, uploads fall back to local disk at ./public/uploads (dev/test).
# UPLOADS_BUCKET="family-recipe-dev-uploads"
# UPLOADS_SIGNED_URL_TTL_SECONDS=3600
# Optional: provide private key if not using metadata signing (e.g., local)
# GCS_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Frontend API base URL — inlined into the CLIENT bundle at BUILD time.
# When unset, the shared API client (src/lib/apiClient.ts) issues same-origin
# /v1/* requests, which src/app/v1/[...path]/route.ts forwards to FastAPI. That
# is how deployed builds run (the deploy workflows pass an empty --build-arg),
# so FastAPI can stay IAM-private and its cookies stay first-party.
# For local dev, point it at the FastAPI service to skip the proxy hop:
# NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# FastAPI URL for SERVER-side calls — read at RUNTIME, never inlined, never
# public. Set by the deploy workflows to the API's Cloud Run URL. Locally you
# can leave it unset: src/lib/apiUpstream.ts falls back to
# NEXT_PUBLIC_API_BASE_URL so `npm run dev` needs no extra config.
# API_INTERNAL_URL="http://localhost:8000"
# Audience for the Cloud Run ID token. Unset locally — without it (and outside
# Cloud Run) apiUpstream skips the metadata-server mint entirely.
# API_INTERNAL_AUDIENCE="https://family-recipe-api-dev-xxxx.us-east1.run.app"
# API_INTERNAL_SERVICE_ACCOUNT_EMAIL="family-recipe-runner@family-recipe-dev.iam.gserviceaccount.com"
# Test/dev escape hatch — pre-minted bearer, skips the metadata fetch.
# API_INTERNAL_STATIC_TOKEN=""

# Claude verification helper (dev-only — NEVER set in production)
# `npm run db:seed` upserts a `claude-test` user with this password so
# `scripts/claude-login.sh` can grab a session cookie in one line. The seed
# step is a no-op when NODE_ENV=production.
CLAUDE_TEST_USER="claude-test"
CLAUDE_TEST_PASSWORD="claude-test-password"
